# Copy to .env (Netlify: Site configuration -> Environment variables) and fill in.
# Both providers are free tier and cardless. This function works with neither set:
# it then answers from the rule layer over assets/bio.json alone.
GEMINI_KEY=
GROQ_KEY=

# Optional overrides.
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# Leave unset in production: the widget posts same-origin, so no CORS is needed.
# CHAT_ALLOWED_ORIGIN=http://localhost:8888
